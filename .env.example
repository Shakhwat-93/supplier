# ==============================================================================
# SUPABASE CONFIGURATION (CHINA SUPPLIER DIRECTORY)
# ==============================================================================
VITE_SUPABASE_URL=http://your-supabase-url.example.com
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (Used strictly server-side / build-time, NEVER exposed to client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# CLOUDFLARE R2 OBJECT STORAGE (BUSINESS CARDS & MEDIA)
# ==============================================================================
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=china-supplier-directory
R2_PREFIX=china-supplier-directory/
